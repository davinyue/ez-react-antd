{
  "name": "ez-react-antd",
  "version": "0.2.7",
  "description": "基于 Ant Design 的公共组件库",
  "type": "module",
  "main": "./dist/ez-react-antd.es.js",
  "module": "./dist/ez-react-antd.es.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/ez-react-antd.es.js",
      "default": "./dist/ez-react-antd.es.js"
    },
    "./style.css": "./dist/index.css"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "watch": "vite build --watch",
    "link:watch": "npm link && vite build --watch",
    "lint": "eslint src --ext ts,tsx",
    "type-check": "tsc --noEmit",
    "test": "vitest",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest --coverage",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build"
  },
  "peerDependencies": {
    "@fortawesome/fontawesome-svg-core": "^7.2.0",
    "@fortawesome/free-regular-svg-icons": "^7.2.0",
    "@fortawesome/free-solid-svg-icons": "^7.2.0",
    "@fortawesome/react-fontawesome": "^3.3.1",
    "antd": ">=6 <7",
    "antd-img-crop": "^4.30.0",
    "react": ">=18 <20",
    "react-dom": ">=18 <20",
    "react-redux": ">=9 <10",
    "react-router": ">=7 <8",
    "react-select": "^5.10.2",
    "react-window": "^2.2.7",
    "redux": ">=5 <6"
  },
  "devDependencies": {
    "@chromatic-com/storybook": "^5.2.1",
    "@fortawesome/fontawesome-svg-core": "^7.2.0",
    "@fortawesome/free-regular-svg-icons": "^7.2.0",
    "@fortawesome/free-solid-svg-icons": "^7.2.0",
    "@fortawesome/react-fontawesome": "^3.3.1",
    "@storybook/addon-a11y": "^10.4.0",
    "@storybook/addon-docs": "^10.4.0",
    "@storybook/addon-onboarding": "^10.4.0",
    "@storybook/addon-vitest": "^10.4.0",
    "@storybook/react-vite": "^10.4.0",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^25.7.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@types/react-redux": "^7.1.34",
    "@typescript-eslint/eslint-plugin": "^8.59.3",
    "@typescript-eslint/parser": "^8.59.3",
    "@vitejs/plugin-react": "^6.0.1",
    "@vitest/browser-playwright": "^4.1.6",
    "@vitest/coverage-v8": "^4.1.6",
    "@vitest/ui": "^4.1.6",
    "antd": "^6.4.0",
    "antd-img-crop": "^4.30.0",
    "eslint": "^9.39.4",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-storybook": "^10.4.0",
    "jsdom": "^29.1.1",
    "less": "^4.6.4",
    "playwright": "^1.60.0",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "react-redux": "^9.2.0",
    "react-router": "^7.15.0",
    "react-select": "^5.10.2",
    "react-window": "^2.2.7",
    "redux": "^5.0.1",
    "storybook": "^10.4.0",
    "typescript": "^6.0.3",
    "vite": "^8.0.12",
